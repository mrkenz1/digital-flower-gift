# Frontend build variable for GitHub Pages.
# Set this to your deployed serverless backend URL.
VITE_CHAT_API_URL=https://your-backend.vercel.app/api/chat

# Backend/serverless variables. Never expose OPENAI_API_KEY in frontend code.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Optional: restrict which site can call your API.
ALLOWED_ORIGIN=https://mrkenz1.github.io
